{
  "name": "wdio-appium-cucumber",
  "version": "1.0.0",
  "description": "Mobile automation for Sauce Labs My Demo App (iOS): WebdriverIO + Appium + Cucumber BDD",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "wdio run ./config/wdio.ios.conf.ts",
    "test:smoke": "wdio run ./config/wdio.ios.conf.ts --cucumberOpts.tags='@smoke'",
    "test:dry-run": "wdio run ./config/wdio.ios.conf.ts --cucumberOpts.dryRun",
    "appium:explore": "appium --port 4724",
    "appium:explore:stop": "lsof -ti tcp:4724 | xargs kill 2>/dev/null || true",
    "report": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "appium:doctor": "appium driver doctor xcuitest",
    "typecheck": "tsc --noEmit",
    "sync:feature-choices": "node .github/scripts/sync-feature-choices.mjs"
  },
  "devDependencies": {
    "@cucumber/cucumber-expressions": "^17.1.0",
    "@cucumber/gherkin": "^29.0.0",
    "@cucumber/messages": "^26.0.1",
    "@types/node": "^26.6.6",
    "@wdio/allure-reporter": "^9.32.0",
    "@wdio/appium-service": "^9.32.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/cucumber-framework": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "@wdio/types": "^9.32.0",
    "allure-commandline": "^2.46.1",
    "appium": "^3.9.0",
    "appium-xcuitest-driver": "^11.17.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "webdriverio": "^9.32.0"
  }
}
